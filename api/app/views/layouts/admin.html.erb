<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cromoswap Backoffice</title>
    <%= csrf_meta_tags %>
    <style>
      :root { --ink:#17211f; --muted:#60706b; --subtle:#d8e1dd; --paper:#f7faf8;
        --surface:#fff; --scan:#1f8a5f; --danger:#d94f4f; }
      * { box-sizing: border-box; }
      body { margin:0; font-family: ui-sans-serif, system-ui, sans-serif; color:var(--ink);
        background:var(--paper); }
      .admin-wrap { max-width: 1000px; margin: 0 auto; padding: 16px; }
      .admin-nav { display:flex; flex-wrap:wrap; gap:12px; align-items:center;
        padding:12px 0; border-bottom:1px solid var(--subtle); margin-bottom:16px; }
      .admin-nav a { color:var(--scan); font-weight:700; text-decoration:none; }
      .admin-nav .brand { font-weight:900; font-size:18px; color:var(--ink); margin-right:8px; }
      .flash { padding:10px 12px; border-radius:8px; margin-bottom:12px; font-weight:700; }
      .flash-notice { background:#e6f3ec; color:#12613f; }
      .flash-alert { background:#fdeaea; color:#8e2727; }
      table { width:100%; border-collapse:collapse; background:var(--surface);
        border:1px solid var(--subtle); border-radius:8px; overflow:hidden; }
      th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--subtle);
        font-size:13px; }
      th { background:#eef4f1; }
      .btn { display:inline-block; padding:6px 10px; border-radius:6px; border:1px solid var(--subtle);
        background:var(--surface); color:var(--ink); font-weight:700; font-size:13px; cursor:pointer;
        text-decoration:none; }
      .btn-primary { background:var(--scan); border-color:var(--scan); color:#fff; }
      .btn-danger { background:#fdeaea; border-color:transparent; color:#8e2727; }
      .actions { display:flex; gap:8px; flex-wrap:wrap; }
      .field { display:flex; flex-direction:column; gap:4px; margin-bottom:12px; max-width:420px; }
      .field input, .field select { padding:8px; border:1px solid var(--subtle); border-radius:6px; }
      .cards { display:flex; flex-wrap:wrap; gap:12px; }
      .card { flex:1; min-width:140px; background:var(--surface); border:1px solid var(--subtle);
        border-radius:8px; padding:14px; }
      .card .num { font-size:28px; font-weight:900; }
      .card .label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.05em; }
    </style>
  </head>
  <body>
    <div class="admin-wrap">
      <nav class="admin-nav">
        <span class="brand">⚽ Backoffice</span>
        <%= link_to "Dashboard", admin_root_path %>
        <%= link_to "Collectors", admin_collectors_path %>
        <%= link_to "Users", admin_users_path %>
        <%= link_to "Sessions", admin_sessions_path %>
        <%= link_to "Scans", admin_scans_path %>
        <%= link_to "Album stickers", admin_album_stickers_path %>
        <%= link_to "Export JSON", admin_export_path %>
        <%= link_to "Export SQL", admin_export_sql_path %>
      </nav>
      <% if flash[:notice] %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="flash flash-alert"><%= flash[:alert] %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
