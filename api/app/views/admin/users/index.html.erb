<h1>Users</h1>
<p><%= link_to "New user", new_admin_user_path, class: "btn btn-primary" %></p>
<table>
  <thead><tr><th>Username</th><th>Linked collector</th><th>Created</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.username %></td>
        <td><%= user.session&.user_name || "—" %></td>
        <td><%= user.created_at&.strftime("%Y-%m-%d %H:%M") %></td>
        <td class="actions">
          <%= link_to "View", admin_user_path(user), class: "btn" %>
          <%= button_to "Delete", admin_user_path(user), method: :delete,
                class: "btn btn-danger", form: { data: { turbo_confirm: "Delete this user?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
