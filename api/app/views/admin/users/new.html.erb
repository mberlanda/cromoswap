<h1>New user</h1>
<%= form_with model: [:admin, @user], url: admin_users_path do |f| %>
  <% if @user.errors.any? %>
    <div class="flash flash-alert">
      <%= pluralize(@user.errors.count, "error") %> prevented saving:
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>
  <div class="field">
    <%= f.label :username %>
    <%= f.text_field :username, autocomplete: "off" %>
  </div>
  <div class="field">
    <%= f.label :password %>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>
  <p class="card label">Username: 3–30 lowercase letters/digits. Password: 8+ characters.</p>
  <%= f.submit "Create user", class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_users_path, class: "btn" %>
<% end %>
