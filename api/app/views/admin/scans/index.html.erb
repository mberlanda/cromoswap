<h1>Scans</h1>
<p><%= link_to "New scan", new_admin_scan_path, class: "btn btn-primary" %></p>
<p class="label">Showing up to 500, newest first.</p>
<table>
  <thead><tr><th>Code</th><th>Collector</th><th>Source</th><th>Captured</th><th></th></tr></thead>
  <tbody>
    <% @scans.each do |scan| %>
      <tr>
        <td><%= scan.normalized_code %></td>
        <td><%= scan.session&.user_name %></td>
        <td><%= scan.source %></td>
        <td><%= scan.captured_at&.strftime("%Y-%m-%d %H:%M") %></td>
        <td class="actions">
          <%= link_to "Edit", edit_admin_scan_path(scan), class: "btn" %>
          <%= button_to "Delete", admin_scan_path(scan), method: :delete, class: "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
