<h1>Backoffice</h1>
<p>Manage collectors, sessions, scans and album stickers, or export all data.</p>

<div class="cards">
  <div class="card"><div class="num"><%= @counts[:collectors] %></div><div class="label">Collectors</div></div>
  <div class="card"><div class="num"><%= @counts[:sessions] %></div><div class="label">Sessions</div></div>
  <div class="card"><div class="num"><%= @counts[:scans] %></div><div class="label">Scans</div></div>
  <div class="card"><div class="num"><%= @counts[:album_stickers] %></div><div class="label">Album stickers</div></div>
</div>
