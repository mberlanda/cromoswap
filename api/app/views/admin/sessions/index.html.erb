<h1>Sessions</h1>
<p><%= link_to "New session", new_admin_session_path, class: "btn btn-primary" %></p>
<table>
  <thead><tr><th>User</th><th>Scans</th><th>Created</th><th></th></tr></thead>
  <tbody>
    <% @sessions.each do |session| %>
      <tr>
        <td><%= session.user_name %></td>
        <td><%= session.scans.size %></td>
        <td><%= session.created_at&.strftime("%Y-%m-%d %H:%M") %></td>
        <td class="actions">
          <%= link_to "View", admin_session_path(session), class: "btn" %>
          <%= link_to "Edit", edit_admin_session_path(session), class: "btn" %>
          <%= button_to "Delete", admin_session_path(session), method: :delete,
                class: "btn btn-danger", form: { data: { turbo_confirm: "Delete this session?" } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
