# Copy to .env.production or export these values before using docker-compose.prod.yml.

APP_IMAGE=wc-sticker-scanner:prod
APP_PORT=3000

# Must match api/config/credentials.yml.enc. Do not bake this into the image.
RAILS_MASTER_KEY=replace-me

# PostgreSQL credentials used by both the db service and Rails.
API_DATABASE_PASSWORD=replace-me-with-a-long-random-password
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=api_production
DATABASE_USER=api
CACHE_DATABASE_NAME=api_production_cache
QUEUE_DATABASE_NAME=api_production_queue
CABLE_DATABASE_NAME=api_production_cable

# Rails runtime tuning.
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true

# Same-origin production deploys can leave these blank.
CORS_ORIGINS=
VITE_API_BASE_URL=

# Build-time versions.
RUBY_VERSION=3.3.6
NODE_VERSION=22
